# --- Secrets / environment ---
.env
.env.local

# --- Auto-install script: embeds the real DATABASE_URL, must never be committed ---
auto_installation.bat

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# --- Databases (local/test only - not the deployed Supabase DB) ---
*.db
*.sqlite3

# --- Node / frontend ---
node_modules/
dist/
dist-ssr/
*.local

# --- Runtime-generated capture/ML output (regenerated on every run) ---
data/raw_packets.csv
data/flow_features.csv
data/capture.log

# --- Trained model binary (56MB+, regenerable via `python ml/train_baseline.py`
# from the data already in data/cicddos2019/ - was committed once, ballooning
# .git by ~56MB per retrain. metadata.json (tiny, informative) stays tracked;
# the .joblib binary itself does not, going forward. ---
models/*.joblib

# --- Evaluation report images/CSVs (regenerated via `python ml/evaluate_model.py`) ---
models/evaluation/

# --- Logs ---
*.log
test_results.log

# --- Editor / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
